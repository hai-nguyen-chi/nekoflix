# ─────────────────────────────────────────────────────────────
# Nekoflix — biến môi trường
# Copy sang .env rồi chạy `pnpm gen:secrets` để điền các secret.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173

# ── Hạ tầng ──────────────────────────────────────────────────
MONGO_HOST=localhost:27017
# Tài khoản quản trị MongoDB. Service KHÔNG dùng tài khoản này —
# mỗi service có user riêng chỉ truy cập được database của mình (ADR-012).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpassword
MONGO_REPLICA_SET=rs0
# Mật khẩu dùng chung cho mọi DB user service ở môi trường dev.
# Production: mỗi service một mật khẩu riêng, lấy từ secret manager.
SERVICE_DB_PASSWORD=devpassword

NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

# ── Observability ────────────────────────────────────────────
# Bỏ trống -> tắt tracing. Với 9 service, ĐỪNG bỏ trống.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ── Object storage ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nekoflix
S3_SECRET_KEY=nekoflix123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=nekoflix-uploads
S3_BUCKET_MEDIA=nekoflix-media
S3_BUCKET_PUBLIC=nekoflix-public

# ── Email (dev: Mailpit) ─────────────────────────────────────
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@nekoflix.local

# ─────────────────────────────────────────────────────────────
# Phase 1+ — chưa dùng ở Phase 0, `pnpm gen:secrets` sẽ điền
# ─────────────────────────────────────────────────────────────

# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# PLAYBACK_TOKEN_SECRET=
# APP_ENCRYPTION_KEY=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d

# ── OAuth ────────────────────────────────────────────────────
# Hướng dẫn lấy credential: docs/16-oauth-setup.md
# Bỏ trống -> /v1/auth/oauth/* trả 503 kèm thông báo rõ, không làm sập gì
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:4000/v1/auth/oauth

# Billing mô phỏng — không có gateway thật (ADR-009)
# BILLING_PROVIDER=mock
# BILLING_WEBHOOK_SECRET=
# BILLING_MOCK_BASE=http://localhost:5173/mock-pay

# TMDB_API_KEY=
# GLITCHTIP_DSN=
