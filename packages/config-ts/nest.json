{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",

    // Bắt buộc cho NestJS DI — Nest đọc type ở runtime qua reflect-metadata
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // emitDecoratorMetadata không tương thích với isolatedModules
    "isolatedModules": false,

    // Property injection của Nest (@InjectModel ...) khai báo mà chưa gán ngay
    "strictPropertyInitialization": false
  }
}
